[Unit]
Description=Captain’s Log durable Syslog ingestion
After=nebulalog-firstboot.service nebulalog-clickhouse.service nebulalog-postgresql.service
Requires=nebulalog-firstboot.service
RequiresMountsFor=/var/lib/nebulalog

[Container]
Image=@NEBULALOG_IMAGE@
ContainerName=nebulalog-ingest
Network=nebulalog.network
User=10001:10001
GroupAdd=20001
ReadOnly=true
NoNewPrivileges=true
Environment=REQUIRE_FIPS=true
Environment=STORAGE_MAINTENANCE_PATH=/run/nebulalog-storage-maintenance/gate.json
Environment=COLLECTOR_STATUS_PATH=/var/lib/nebulalog/runtime/collector.json
DropCapability=all
EnvironmentFile=/etc/nebulalog/ingest.env
Environment=SYSLOG_UDP=:5514
Environment=SYSLOG_TCP=:5514
Environment=SYSLOG_TLS=:6514
Environment=SPOOL_DIR=/var/lib/nebulalog/spool
Volume=/var/lib/nebulalog/spool:/var/lib/nebulalog/spool:Z
Volume=/var/lib/nebulalog/runtime:/var/lib/nebulalog/runtime:z
Volume=/var/lib/nebulalog/manager/storage-maintenance:/run/nebulalog-storage-maintenance:ro,z
Volume=/var/lib/nebulalog/configuration/tls:/etc/nebulalog/tls:ro,z
Tmpfs=/tmp:rw,noexec,nosuid,nodev,size=64m
PublishPort=514:5514/udp
PublishPort=514:5514/tcp
PublishPort=6514:6514/tcp
Exec=ingest

[Service]
Restart=on-failure
RestartSec=5
TimeoutStopSec=120
TimeoutStartSec=900
[Install]
WantedBy=multi-user.target
