[Unit]
Description=Captain’s Log event ClickHouse
After=nebulalog-firstboot.service
Requires=nebulalog-firstboot.service
RequiresMountsFor=/var/lib/nebulalog

[Container]
Image=@CLICKHOUSE_IMAGE@
ContainerName=nebulalog-clickhouse
Network=nebulalog.network
NetworkAlias=clickhouse
User=101:101
GroupAdd=20001
ReadOnly=true
NoNewPrivileges=true
DropCapability=all
EnvironmentFile=/etc/nebulalog/clickhouse.env
Secret=nebulalog-ch-password,type=mount,uid=101,gid=101,mode=0400
Volume=/var/lib/nebulalog/clickhouse:/var/lib/clickhouse:Z
Volume=/var/lib/nebulalog/configuration/clickhouse-client.xml:/etc/nebulalog/clickhouse-client.xml:ro,Z
Volume=/var/lib/nebulalog/configuration/tls:/etc/nebulalog/tls:ro,z
Volume=/etc/crypto-policies/config:/etc/crypto-policies/config:ro
Volume=/var/lib/nebulalog/clickhouse-logs:/var/log/clickhouse-server:Z
Tmpfs=/run/nebulalog-clickhouse:rw,noexec,nosuid,nodev,size=256m,mode=0700,U
Tmpfs=/tmp:rw,noexec,nosuid,nodev,size=64m
Ulimit=nofile:262144:262144

[Service]
Restart=on-failure
TimeoutStartSec=900
TimeoutStopSec=120
[Install]
WantedBy=multi-user.target
