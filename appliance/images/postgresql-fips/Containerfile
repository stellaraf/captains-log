FROM docker.io/rockylinux/rockylinux:9.8@sha256:ed654c694190a670bb5c33f68995b862214fc96ffbdca95e07a8935ba0a3717d
USER 0:0
COPY --from=packages /opt/nebulalog/inputs /opt/nebulalog/inputs
COPY appliance/images/postgresql-fips/BOM.json /opt/nebulalog/BOM.json
COPY LICENSE /opt/nebulalog/LICENSE-NEBULALOG
RUN groupadd --gid 999 postgres && \
    useradd --system --uid 999 --gid 999 --home-dir /var/lib/postgresql --no-create-home --shell /sbin/nologin postgres && \
    rpm --import /opt/nebulalog/inputs/PGDG-RPM-GPG-KEY-RHEL /etc/pki/rpm-gpg/RPM-GPG-KEY-Rocky-9 && \
    rpmkeys --checksig /opt/nebulalog/inputs/*.rpm > /opt/nebulalog/rpm-signatures.txt && \
    dnf -y --disablerepo='*' --setopt=install_weak_deps=False --setopt=localpkg_gpgcheck=True install /opt/nebulalog/inputs/*.rpm && \
    dnf clean all && rm -rf /opt/nebulalog/inputs /var/cache/dnf && \
    update-crypto-policies --set FIPS --no-reload && \
    truncate -s 0 /etc/machine-id && rm -f /var/lib/dbus/machine-id /var/lib/systemd/random-seed && \
    install -d -o 999 -g 999 -m 0700 /var/lib/postgresql/data /run/postgresql && \
    rpm -qa --qf '%{NAME}\t%{VERSION}-%{RELEASE}\t%{ARCH}\t%{LICENSE}\n' | sort > /opt/nebulalog/rpm-bom.tsv
COPY --chmod=0555 appliance/images/postgresql-fips/entrypoint.py /opt/nebulalog/entrypoint.py
COPY --chmod=0555 appliance/images/postgresql-fips/crypto_gate.py /opt/nebulalog/crypto_gate.py
COPY appliance/images/postgresql-fips/postgresql.conf appliance/images/postgresql-fips/pg_hba.conf /etc/nebulalog/
ENV PATH=/usr/pgsql-17/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin PGDATA=/var/lib/postgresql/data PG_MAJOR=17 LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 PYTHONDONTWRITEBYTECODE=1 OPENSSL_CONF=/etc/pki/tls/openssl.cnf
USER 999:999
LABEL org.opencontainers.image.title="Captain’s Log PostgreSQL FIPS candidate" \
      org.opencontainers.image.version="17.11-nebulalog.2" \
      org.opencontainers.image.licenses="AGPL-3.0-only AND PostgreSQL AND LicenseRef-Rocky-Component-Licenses"
EXPOSE 5432
STOPSIGNAL SIGINT
ENTRYPOINT ["/usr/bin/python3.14", "/opt/nebulalog/entrypoint.py"]
CMD ["postgres"]
