# Build from the repository root. Digests are the linux/amd64 manifests.
FROM quay.io/keycloak/keycloak:26.7.3@sha256:88943b6ad06d6293a239f0dfca5acec64218c9b3ab327bf9c936acf408a6ae3b AS distribution
FROM registry.access.redhat.com/ubi9/openjdk-21-runtime:1.24@sha256:5c5fed069071ceb9a65e280611b041483ed928158625f2e7c96b70477ab90c52 AS builder
USER 0:0
COPY --from=distribution --chown=1000:1000 /opt/keycloak /opt/keycloak
ADD --checksum=sha256:044fcd8a29d236edea8a5b414406cdae63b475f9ad9f05fe2dc904a277941115 --chown=1000:1000 https://repo.maven.apache.org/maven2/org/bouncycastle/bc-fips/2.1.2/bc-fips-2.1.2.jar /opt/keycloak/providers/bc-fips-2.1.2.jar
ADD --checksum=sha256:688410563445e1a65ff33cb67842499f0788994d752c3df8f7ea4a0d40ddbf50 --chown=1000:1000 https://repo.maven.apache.org/maven2/org/bouncycastle/bctls-fips/2.1.22/bctls-fips-2.1.22.jar /opt/keycloak/providers/bctls-fips-2.1.22.jar
ADD --checksum=sha256:c4370064664d474d8681f55f302cfdade4cae0f3d798b10fd18b0ab8fbd6fed1 --chown=1000:1000 https://repo.maven.apache.org/maven2/org/bouncycastle/bcpkix-fips/2.1.10/bcpkix-fips-2.1.10.jar /opt/keycloak/providers/bcpkix-fips-2.1.10.jar
ADD --checksum=sha256:503aaf5c2c5b7c729547462efe13699b5f6dacf9be150b7c48bba974b793dc92 --chown=1000:1000 https://repo.maven.apache.org/maven2/org/bouncycastle/bcutil-fips/2.1.5/bcutil-fips-2.1.5.jar /opt/keycloak/providers/bcutil-fips-2.1.5.jar
COPY --chown=1000:1000 deploy/keycloak/themes/nebulalog /opt/keycloak/themes/nebulalog
COPY appliance/images/keycloak-fips/bc-fips.sha256 /tmp/bc-fips.sha256
RUN cd /opt/keycloak/providers && sha256sum -c /tmp/bc-fips.sha256 && \
    cp bc-fips-*.jar bctls-fips-*.jar bcutil-fips-*.jar /opt/keycloak/bin/client/lib/ && \
    touch -m --date=@1743465600 /opt/keycloak/providers/*.jar
USER 1000:1000
WORKDIR /opt/keycloak
ENV KC_DB=postgres KC_HEALTH_ENABLED=true KC_METRICS_ENABLED=true \
    KC_FEATURES=fips,recovery-codes,passkeys KC_FIPS_MODE=strict
# Build-time augmentation generates no appliance account, TLS key or realm secret.
RUN JAVA_OPTS_KC_HEAP="-Xms64m -Xmx1024m" JAVA_OPTS_APPEND="-XX:ActiveProcessorCount=2" /opt/keycloak/bin/kc.sh build --features=fips,recovery-codes,passkeys --fips-mode=strict

FROM registry.access.redhat.com/ubi9/openjdk-21-runtime:1.24@sha256:5c5fed069071ceb9a65e280611b041483ed928158625f2e7c96b70477ab90c52
USER 0:0
COPY --from=builder --chown=1000:1000 /opt/keycloak /opt/keycloak
COPY --chmod=0555 appliance/images/keycloak-fips/entrypoint.sh /opt/nebulalog/keycloak-entrypoint
COPY LICENSE /opt/nebulalog/LICENSE-NEBULALOG
COPY appliance/images/keycloak-fips/bc-fips.sha256 appliance/images/keycloak-fips/BOM.json appliance/images/keycloak-fips/LICENSE-BOUNCY-CASTLE.txt /opt/nebulalog/
RUN rpm -qa --qf '%{NAME}\t%{VERSION}-%{RELEASE}\t%{ARCH}\t%{LICENSE}\n' | sort > /opt/nebulalog/rpm-bom.tsv && \
    chmod -R a-w /opt/keycloak && chmod u+w /opt/keycloak/data
USER 1000:1000
WORKDIR /opt/keycloak
ENV HOME=/opt/keycloak KC_DB=postgres KC_HEALTH_ENABLED=true KC_METRICS_ENABLED=true \
    KC_FEATURES=fips,recovery-codes,passkeys KC_FIPS_MODE=strict \
    KC_HTTP_ENABLED=false KC_HTTPS_PORT=8443 KC_CACHE=local
LABEL org.opencontainers.image.title="Captain’s Log Keycloak strict-FIPS candidate" \
      org.opencontainers.image.version="26.7.3-nebulalog.1" \
      org.opencontainers.image.licenses="AGPL-3.0-only AND Apache-2.0 AND LicenseRef-Bouncy-Castle AND LicenseRef-UBI-Component-Licenses"
EXPOSE 8443 9000
ENTRYPOINT ["/opt/nebulalog/keycloak-entrypoint"]
CMD ["start", "--optimized"]
