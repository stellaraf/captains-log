[Unit]
Description=Check GitHub Releases and automatically update Captain's Log
RequiresMountsFor=/var/lib/nebulalog
After=network-online.target nebulalog-firstboot.service nebulalog-reboot-verify.service
Wants=network-online.target
ConditionPathExists=/etc/nebulalog/configured
ConditionPathExists=/etc/nebulalog/github-updates.json
[Service]
Type=oneshot
ExecStart=/usr/bin/python3.14 -I -B /usr/libexec/nebulalog/host-boot github-updates
TimeoutStartSec=2h
UMask=0077
