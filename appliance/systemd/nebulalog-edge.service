[Unit]
After=nebulalog-maintenance-gate.service
Requires=nebulalog-maintenance-gate.service
Description=Captain’s Log HTTPS edge using system FIPS crypto policy
After=nebulalog-firstboot.service nebulalog-api.service nebulalog-keycloak.service
Requires=nebulalog-firstboot.service
RequiresMountsFor=/var/lib/nebulalog
ConditionPathExists=/etc/httpd/conf.d/nebulalog.conf

[Service]
Type=simple
ExecStartPre=/usr/sbin/httpd -t
ExecStart=/usr/sbin/httpd -DFOREGROUND
ExecReload=/usr/sbin/httpd -k graceful
Restart=on-failure
RestartSec=5
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/log/httpd /run/httpd /var/lib/httpd
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
