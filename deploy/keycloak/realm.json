{
  "realm": "nebulalog",
  "displayName": "Captain’s Log",
  "displayNameHtml": "Captain’s Log",
  "loginTheme": "nebulalog",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "passwordPolicy": "length(14) and digits(1) and lowerCase(1) and upperCase(1)",
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA256",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyLookAheadWindow": 1,
  "browserFlow": "nebulalog-browser",
  "roles": {
    "client": {
      "nebulalog": [
        {
          "name": "ADMINISTRATOR"
        },
        {
          "name": "ANALYST"
        },
        {
          "name": "VIEWER"
        }
      ]
    }
  },
  "clients": [
    {
      "clientId": "nebulalog",
      "name": "Captain’s Log",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://127.0.0.1:18080/*",
        "http://localhost:18080/*"
      ],
      "webOrigins": [
        "http://127.0.0.1:18080",
        "http://localhost:18080"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://127.0.0.1:18080/*"
      },
      "protocolMappers": [
        {
          "name": "nebulalog-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "nebulalog",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "authenticationFlows": [
    {
      "alias": "nebulalog-browser",
      "description": "Captain’s Log mandatory MFA browser flow",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "authenticatorFlow": false
        },
        {
          "flowAlias": "nebulalog-forms",
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "authenticatorFlow": true
        }
      ]
    },
    {
      "alias": "nebulalog-forms",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorFlow": false
        },
        {
          "authenticator": "auth-otp-form",
          "requirement": "REQUIRED",
          "priority": 20,
          "authenticatorFlow": false
        }
      ]
    },
    {
      "alias": "nebulalog-broker-mfa",
      "description": "Captain’s Log required OTP after external identity authentication",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-otp-form",
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorFlow": false
        }
      ]
    }
  ]
}
