{
  "realm": "nebulalog",
  "displayName": "Captain’s Log",
  "displayNameHtml": "Captain’s Log",
  "loginTheme": "nebulalog",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "passwordPolicy": "length(14) and digits(1) and lowerCase(1) and upperCase(1)",
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA256",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyLookAheadWindow": 1,
  "browserFlow": "nebulalog-browser",
  "roles": {
    "client": {
      "nebulalog": [
        {
          "name": "ADMINISTRATOR"
        },
        {
          "name": "ANALYST"
        },
        {
          "name": "VIEWER"
        }
      ]
    }
  },
  "clients": [
    {
      "clientId": "nebulalog",
      "name": "Captain’s Log",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "basic",
        "profile",
        "email",
        "acr"
      ],
      "optionalClientScopes": [],
      "redirectUris": [
        "http://127.0.0.1:18080/*",
        "http://localhost:18080/*"
      ],
      "webOrigins": [
        "http://127.0.0.1:18080",
        "http://localhost:18080"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://127.0.0.1:18080/*"
      },
      "protocolMappers": [
        {
          "name": "nebulalog-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "nebulalog",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "captains-log-administrator-projection",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-role-name-mapper",
          "config": {
            "role": "nebulalog.ADMINISTRATOR",
            "new.role.name": "captains-log-token-roles.ADMINISTRATOR"
          }
        },
        {
          "name": "captains-log-analyst-projection",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-role-name-mapper",
          "config": {
            "role": "nebulalog.ANALYST",
            "new.role.name": "captains-log-token-roles.ANALYST"
          }
        },
        {
          "name": "captains-log-viewer-projection",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-role-name-mapper",
          "config": {
            "role": "nebulalog.VIEWER",
            "new.role.name": "captains-log-token-roles.VIEWER"
          }
        },
        {
          "name": "captains-log-application-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "config": {
            "usermodel.clientRoleMapping.clientId": "captains-log-token-roles",
            "claim.name": "resource_access.nebulalog.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "captains-log-token-roles",
      "name": "Captain’s Log token role projection",
      "enabled": true,
      "protocol": "openid-connect",
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "defaultClientScopes": [],
      "optionalClientScopes": []
    }
  ],
  "clientScopeMappings": {
    "nebulalog": [
      {
        "client": "nebulalog",
        "roles": [
          "ADMINISTRATOR",
          "ANALYST",
          "VIEWER"
        ]
      }
    ]
  },
  "authenticationFlows": [
    {
      "alias": "nebulalog-browser",
      "description": "Captain’s Log mandatory MFA browser flow",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "authenticatorFlow": false
        },
        {
          "flowAlias": "nebulalog-forms",
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "authenticatorFlow": true
        }
      ]
    },
    {
      "alias": "nebulalog-forms",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorFlow": false
        },
        {
          "authenticator": "auth-otp-form",
          "requirement": "REQUIRED",
          "priority": 20,
          "authenticatorFlow": false
        }
      ]
    },
    {
      "alias": "nebulalog-broker-mfa",
      "description": "Captain’s Log required OTP after external identity authentication",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-otp-form",
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorFlow": false
        }
      ]
    }
  ]
}
